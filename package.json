{
  "name": "seanfinch.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "photos:sanitize": "node scripts/strip-exif.mjs",
    "handoff": "node scripts/handoff.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "security:headers": "node scripts/check-headers.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/jost": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "exifr": "7.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-responsive": "10.0.1",
    "react-responsive-carousel": "3.2.23",
    "react-router-dom": "7.18.5",
    "react-zoom-pan-pinch": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-transition-group": "4.4.12",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
